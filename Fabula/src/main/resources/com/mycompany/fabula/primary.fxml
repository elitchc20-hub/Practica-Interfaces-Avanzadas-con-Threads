<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ProgressBar?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.fabula.PrimaryController">
   <children>
      <Label text="Fabulas graficas de Esopo" />      
      <Label text="La Liebre y la Tortuga" />
      <Button fx:id="btnIniciar" text="¡Iniciar Carrera!" onAction="#btnIniciar_click"/>
      
      <Label fx:id="lblEstadoLiebre" text="La liebre: Lista" />
      <ProgressBar fx:id="progressIniciandoLiebre" prefHeight="20.0" prefWidth="350.0" progress="0.0" />
      
      <Label fx:id="lblEstadoTortuga" text="La tortuga: Lista" />
      <ProgressBar fx:id="progressIniciandoTortuga" prefHeight="20.0" prefWidth="350.0" progress="0.0" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
