<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.contar.PrimaryController">
   <children>
      <Label text="Conteo" />
      <Label text="Contar numero de clics" />
      <TextField fx:id="txtConteo" text="0" editable="false" prefWidth="300.0" />
      <Button fx:id="btnContar" text="¡Contar!" onAction="#btnContar_click" />
      
      <Label text="Esperar 10 segundos" /> 
      <ProgressBar fx:id="progressBar" prefHeight="25.0" prefWidth="200.0" progress="0.0" />
      <Button fx:id="btnEsperar" text="¡Esperar!" onAction="#btnEsperar_click" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
